#!/usr/bin/env bash
# commit-msg hook for Conventional Commits

# Regex to validate the commit message
# e.g., feat(module): add something new
commit_regex='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-zA-Z0-9_-]+\))?: [a-zA-Z0-9].+$'

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Ignore merge commits
if [[ "$commit_msg" =~ ^Merge.* ]]; then
    exit 0
fi

if ! [[ "$commit_msg" =~ $commit_regex ]]; then
    echo "ERROR: Invalid commit message format."
    echo "Commit message must follow Conventional Commits standard:"
    echo "  <type>(<scope>): <subject>"
    echo ""
    echo "Examples:"
    echo "  feat(api): add new authentication endpoint"
    echo "  chore(repo): update issue templates"
    echo ""
    echo "Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
    exit 1
fi
